{
  "@context": {
    "@vocab": "https://raw.githubusercontent.com/sanketika-labs/beckn-schema/refs/heads/main/becknv2-schema/schemas/core/",
    "beckn": "https://raw.githubusercontent.com/sanketika-labs/beckn-schema/refs/heads/main/becknv2-schema/schemas/core/",
    "schema": "https://schema.org/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#"
  },
  "@id": "https://raw.githubusercontent.com/sanketika-labs/beckn-schema/refs/heads/main/becknv2-schema/schemas/core/Image",
  "@type": "owl:Class",
  "rdfs:label": "Image",
  "rdfs:comment": "Describes an image",
  "rdfs:subClassOf": "schema:ImageObject",
  "rdfs:isDefinedBy": "https://raw.githubusercontent.com/sanketika-labs/beckn-schema/refs/heads/main/becknv2-schema/schemas/core/",
  "rdfs:seeAlso": "https://schema.org/ImageObject",
  "owl:equivalentClass": {
    "@type": "owl:Class",
    "owl:intersectionOf": [
      "schema:ImageObject",
      {
        "@type": "owl:Restriction",
        "owl:onProperty": {
          "@id": "beckn:sizeType",
          "rdfs:label": "Image Size Type",
          "rdfs:comment": "The size category of the image (xs, sm, md, lg, xl, or custom)"
        },
        "owl:allValuesFrom": {
          "@type": "owl:Class",
          "owl:oneOf": [
            {"@id": "beckn:xs"},
            {"@id": "beckn:sm"},
            {"@id": "beckn:md"},
            {"@id": "beckn:lg"},
            {"@id": "beckn:xl"},
            {"@id": "beckn:custom"}
          ]
        }
      }
    ]
  }
}
